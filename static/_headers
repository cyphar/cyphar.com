# Security headers for the whole site, which only apply to 200 pages.
# cyphar.com is a fairly dumb static site and makes no foreign requests, so the
# CSP is deny-by-default.
#
# HSTS is set here (so it stays in version control) but that means you must not
# enable it in the Cloudflare dashboard -- duplicate headers get joined with
# commas which produces an invalid HSTS header.
/*
  Content-Security-Policy: base-uri 'none'; default-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; font-src 'self'; img-src 'self'; style-src 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer, strict-origin-when-cross-origin
  X-Download-Options: noopen
  X-Permitted-Cross-Domain-Policies: none
