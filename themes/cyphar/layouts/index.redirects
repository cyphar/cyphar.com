{{- /* The "{{-" chomping eats the newline ending the license header, which
       would glue the first rule onto the final comment line above (and thus
       comment it out) -- emit the newline explicitly. */ -}}
{{- printf "\n\n" -}}

{{- /* Redirects for go-import submodule pages (longest-first). */ -}}
{{- range $e := sort hugo.Data.govanity "import" "desc" -}}
{{- $p := strings.TrimPrefix "cyphar.com" $e.import -}}
{{- printf "%s/*  %s/  200\n" $p $p -}}
{{- end -}}

{{- /* "Dynamic" /_redirects generation based on data/redirects.yaml. */ -}}

{{- range $e := hugo.Data.redirects.shortcuts -}}
{{- printf "%s  %s  %d\n" $e.from $e.to $e.code -}}
{{- end -}}

/src/*	https://github.com/cyphar/:splat	302
/src	https://github.com/cyphar	302
